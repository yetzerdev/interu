# --- Conexión Supabase (pública) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- SOLO SERVIDOR. Nunca expongas esto al cliente. ---
# La usa el cliente admin (service_role) para crear cuentas, generar alias
# y acceder al schema `private` de identidad real (bypasea RLS).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Origen del sitio, sin slash final. La usa oauthAction para armar la
# URL de retorno del SSO (Google / Microsoft 365). ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend. Solo si usas el hook de email; con SMTP custom en Supabase
# no hace falta aqui. Ver https://resend.com/docs/send-with-supabase-smtp ---
# SMTP: host smtp.resend.com · puerto 465 · usuario resend · password = API key
# RESEND_API_KEY=re_xxxxxxxx

# --- Secreto para HMAC de evidencia (revocación sin PII) ---
# Solo lo usa el flujo legacy de verificación por carné.
ALIAS_HMAC_SECRET=cambia-esto-por-un-secreto-largo
